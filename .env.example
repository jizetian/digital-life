# Local paths only. Do not put chat exports or database files in git.
CHATTWIN_DB_PATH=data/database/cleaned_messages.db
CHATTWIN_RAW_DIR=data/raw/moect_export

# Segmentation. Defaults match config/settings.yaml.
# CHATTWIN_SEGMENT_GAP_MINUTES=30
# CHATTWIN_SEGMENT_MAX_MESSAGES=50
# CHATTWIN_SEGMENT_OVERLAP=4
# CHATTWIN_SEGMENT_OVERLAP_ON_TIME_GAP=false

# L1 distillation. Ollama's OpenAI-compatible endpoint is the local default.
# Leave the API key empty for Ollama. Do not commit a real key.
CHATTWIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
CHATTWIN_LLM_MODEL=qwen2.5:7b
CHATTWIN_LLM_API_KEY=
# Optional cache-buster mixed into task_id. Empty means "use the model name".
CHATTWIN_MODEL_VERSION=
# CHATTWIN_DISTILL_BATCH_SIZE=8
# CHATTWIN_DISTILL_MAX_ATTEMPTS=3
# CHATTWIN_PROMPT_VERSION=l1-v1
