# Local paths only. Do not put chat exports or database files in git.
CHATTWIN_DB_PATH=data/database/cleaned_messages.db
CHATTWIN_RAW_DIR=data/raw/moect_export

# Segmentation. Defaults match config/settings.yaml.
# CHATTWIN_SEGMENT_GAP_MINUTES=30
# CHATTWIN_SEGMENT_MAX_MESSAGES=50
# CHATTWIN_SEGMENT_OVERLAP=4
# CHATTWIN_SEGMENT_OVERLAP_ON_TIME_GAP=false

# L1 distillation. Ollama's OpenAI-compatible endpoint is the local default.
# Leave the API key empty for Ollama. Do not commit a real key.
CHATTWIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
CHATTWIN_LLM_MODEL=qwen2.5:7b
CHATTWIN_LLM_API_KEY=
# Optional cache-buster mixed into task_id. Empty means "use the model name".
CHATTWIN_MODEL_VERSION=
# CHATTWIN_DISTILL_BATCH_SIZE=8
# CHATTWIN_DISTILL_MAX_ATTEMPTS=3
# CHATTWIN_PROMPT_VERSION=l1-v1

# L2/L3 personality. Uses the LLM settings above. Generated profiles stay local.
# CHATTWIN_PERSONALITY_OUTPUT_DIR=personality
# CHATTWIN_PERSONALITY_BATCH_SIZE=20
# CHATTWIN_PERSONALITY_MIN_INDEPENDENT=2
# CHATTWIN_PERSONALITY_MAX_ATTEMPTS=3
# CHATTWIN_L2_PROMPT_VERSION=l2-v1

# Long-term memory. Uses the LLM settings above. The SQLite file stays local.
# CHATTWIN_MEMORY_BATCH_SIZE=4
# CHATTWIN_MEMORY_MAX_ATTEMPTS=3
# CHATTWIN_MEMORY_MAX_EXISTING=40
# CHATTWIN_MEMORY_PROMPT_VERSION=memory-v1

# Hybrid retrieval. BGE-M3 through an OpenAI-compatible /embeddings endpoint.
# Leave the base URL empty to reuse CHATTWIN_LLM_BASE_URL. The key is the same
# CHATTWIN_LLM_API_KEY unless CHATTWIN_EMBEDDING_API_KEY is set. Do not commit it.
# CHATTWIN_EMBEDDING_PROVIDER=openai
# CHATTWIN_EMBEDDING_MODEL=bge-m3
# CHATTWIN_EMBEDDING_BASE_URL=
# CHATTWIN_EMBEDDING_API_KEY=
# CHATTWIN_QDRANT_PATH=data/qdrant
# CHATTWIN_QDRANT_URL=
# CHATTWIN_QDRANT_API_KEY=
# CHATTWIN_VECTOR_BACKEND=qdrant
# Optional rerank hook. Search calls it only with --rerank or "rerank": true.
# CHATTWIN_RERANK_URL=
# CHATTWIN_RERANK_API_KEY=

# Digital-twin chat. Uses CHATTWIN_LLM_BASE_URL, CHATTWIN_LLM_MODEL, and
# CHATTWIN_LLM_API_KEY above. The reply is synchronous JSON, not a stream.
# CHATTWIN_CHAT_TARGET_NAME=不吃香菜
# CHATTWIN_CHAT_MAX_CHARS=6000
# CHATTWIN_CHAT_HISTORY_TURNS=8
# CHATTWIN_CHAT_RETRIEVAL_LIMIT=8
# CHATTWIN_CHAT_TEMPERATURE=0.4
